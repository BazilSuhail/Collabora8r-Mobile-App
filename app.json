{
  "expo": {
    "name": "Collabor8r",
    "slug": "collabr8r-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "collabr8r",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.collabora8r"
    },
    "android": {
      "package": "com.anonymous.collabora8r",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/apple-touch-icon.png",
        "backgroundColor": "#f3efe8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/apple-touch-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-image"
    ],
    "icon": "./assets/images/apple-touch-icon.png",
    "backgroundColor": "#f3efe8"
  }
}
